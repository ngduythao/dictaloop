{
  "name": "dictaloop",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vinext dev --port 5173",
    "build": "vinext build",
    "start": "pnpm build && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --test lib/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "pnpm test && pnpm typecheck && pnpm lint"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@huggingface/transformers": "4.3.2",
    "clsx": "2.1.1",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "lucide-react": "1.65.0",
    "next": "16.4.3",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.3",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vinext": "1.4.0",
    "vite": "8.3.5"
  },
  "type": "module",
  "description": "Dictation trainer for English learners: listen sentence by sentence, write what you hear, see what you missed.",
  "packageManager": "pnpm@12.16.1"
